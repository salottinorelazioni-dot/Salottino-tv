name: Foyho TV Fire 1.0

on:
  push:
    branches: [ main ]
    paths:
      - '.github/workflows/Foyho-TV-Fire-1.0.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      ANDROID_HOME: /usr/local/lib/android/sdk

    steps:
      - name: Checkout latest approved Foyho base
        uses: actions/checkout@v4
        with:
          ref: experiment-3.5
          fetch-depth: 0

      - name: Adapt Foyho TV for Amazon Fire OS
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import re

          # Build separata, installabile come app Fire dedicata.
          gradle = Path('app/build.gradle')
          s = gradle.read_text(encoding='utf-8')
          s = re.sub(r"applicationId\s+'[^']+'", "applicationId 'it.salottino.tv.fire'", s, count=1)
          s = re.sub(r"minSdk\s+\d+", "minSdk 22", s, count=1)
          s = re.sub(r"versionCode\s+\d+", "versionCode 1", s, count=1)
          s = re.sub(r"versionName\s+'[^']+'", "versionName '1.0.0-fire'", s, count=1)
          gradle.write_text(s, encoding='utf-8')

          # Fire TV: touchscreen e faketouch non obbligatori; mantiene Leanback launcher.
          manifest = Path('app/src/main/AndroidManifest.xml')
          m = manifest.read_text(encoding='utf-8')
          if 'android.hardware.faketouch' not in m:
              m = m.replace(
                  '<uses-feature android:name="android.hardware.touchscreen" android:required="false" />',
                  '<uses-feature android:name="android.hardware.touchscreen" android:required="false" />\n'
                  '    <uses-feature android:name="android.hardware.faketouch" android:required="false" />'
              )

          m = m.replace('android:label="Foyho TV EXP"', 'android:label="Foyho TV Fire"')
          m = m.replace('android:label="Foyho TV EXP - Sostituisci launcher"',
                        'android:label="Foyho TV Fire - Sostituisci launcher"')
          manifest.write_text(m, encoding='utf-8')

          print('--- build.gradle Fire ---')
          print(gradle.read_text(encoding='utf-8'))
          print('--- manifest Fire: controlli ---')
          for line in manifest.read_text(encoding='utf-8').splitlines():
              if ('uses-feature' in line or 'android:label=' in line or
                  'LEANBACK_LAUNCHER' in line):
                  print(line)
          PY

      - name: Set up Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'

      - name: Install Android SDK
        run: |
          yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null || true
          $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager "platforms;android-35" "build-tools;35.0.0"

      - name: Set up Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build Foyho TV Fire APK
        run: gradle :app:assembleDebug --stacktrace

      - name: Rename APK
        run: cp app/build/outputs/apk/debug/app-debug.apk Foyho-TV-Fire-1.0.0.apk

      - name: Upload Fire APK
        uses: actions/upload-artifact@v4
        with:
          name: Foyho-TV-Fire-1.0.0-APK
          path: Foyho-TV-Fire-1.0.0.apk
